{
  "name": "dsh-plugin-scope",
  "version": "0.4.3",
  "description": "Per-conversation plugin scopes for DeepSeek Harness: global, on demand, off, with token estimates and dsh-market integration. \u00b7 DSH \u63d2\u4ef6\u4f5c\u7528\u57df\uff1a\u5168\u5c40/\u6309\u9700/\u5173\u95ed\uff0c\u6309\u5bf9\u8bdd\u7b5b\u9009\u63d2\u4ef6\u5e76\u8282\u7701\u5de5\u5177\u58f0\u660e token\u3002",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-manager",
    "scope",
    "token-saving",
    "dsh-market"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/core.js && node --check lib/state.js && node --check lib/index.js && node --check lib/client.js",
    "test": "node --test test/*.test.mjs",
    "pack": "npm pack --dry-run"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "icon": "icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UserShi/dsh-plugin-scope.git"
  },
  "homepage": "https://github.com/UserShi/dsh-plugin-scope",
  "bugs": {
    "url": "https://github.com/UserShi/dsh-plugin-scope/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
